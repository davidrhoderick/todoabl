{
  "name": "todoabl",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "pnpm -r build",
    "check": "pnpm lint && pnpm format:check",
    "codegen": "graphql-codegen --config packages/graphql/codegen.ts",
    "dev:api": "pnpm --filter @todoabl/api dev",
    "dev:mobile": "pnpm --filter @todoabl/mobile dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "prepare": "husky",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@eddeee888/gcg-typescript-resolver-files": "latest",
    "@eslint/js": "^9.39.1",
    "@graphql-codegen/cli": "latest",
    "@graphql-codegen/typescript": "latest",
    "@graphql-codegen/typescript-operations": "latest",
    "@graphql-codegen/typescript-react-apollo": "latest",
    "@types/node": "latest",
    "@typescript-eslint/eslint-plugin": "latest",
    "@typescript-eslint/parser": "latest",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "latest",
    "eslint-plugin-import": "latest",
    "eslint-plugin-simple-import-sort": "latest",
    "graphql-scalars": "latest",
    "globals": "latest",
    "husky": "latest",
    "lint-staged": "latest",
    "prettier": "latest",
    "typescript": "latest"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx,json,md,yml,yaml,graphql}": [
      "prettier --write"
    ],
    "*.{js,mjs,cjs,ts,tsx}": [
      "eslint --fix"
    ]
  }
}
